        "Hard":   { "ai": { "reactionTime": 0.08, "aggressionBias": 0.78, "jumpFrequency": 0.030 } },
        "Brutal": { "ai": { "reactionTime": 0.03, "aggressionBias": 0.95, "jumpFrequency": 0.050 } }
