        "Normal":    { "eventChances": { "danger": 0.35, "weather": 0.20, "good": 0.17 } },
        "Hard":      { "eventChances": { "danger": 0.55, "weather": 0.28, "good": 0.10 } },
        "Nightmare": { "eventChances": { "danger": 0.70, "weather": 0.35, "good": 0.05 } }
      }
    },
    {
      "key": "Starting Health",
      "help": "Your health at the start of the journey.",
      "opts": ["50", "75", "100"],
      "def": "100",
      "apply": {
        "50":  { "start": { "health": 50,  "maxHealth": 100 } },
        "75":  { "start": { "health": 75,  "maxHealth": 100 } },
        "100": { "start": { "health": 100, "maxHealth": 100 } }
      }
    },
    {
      "key": "Starting Money",
      "help": "Kr available at the start.",
      "opts": ["100 kr", "200 kr", "300 kr", "500 kr"],
      "def": "300 kr",
      "apply": {
