{
  "id": "RoadToSkagen",
  "title": "Road to Skagen",
  "icon": "🇩🇰",
  "color": "#4caf50",
  "tags": ["ADVENTURE", "SOLO", "TEXT RPG"],
  "desc": "Walk 387 km from Copenhagen to the tip of Denmark. Manage health, food, and money across dangerous terrain.",
  "config": [
    {
      "key": "Difficulty",
      "help": "Adjusts danger frequency and event magnitudes.",
      "opts": ["Easy", "Normal", "Hard", "Nightmare"],
