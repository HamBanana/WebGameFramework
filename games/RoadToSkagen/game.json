        "200 kr": { "start": { "money": 200 } },
        "300 kr": { "start": { "money": 300 } },
        "500 kr": { "start": { "money": 500 } }
      }
    },
    {
      "key": "Starting Food",
      "help": "Kg of food in your pack.",
      "opts": ["5 kg", "10 kg", "15 kg", "20 kg"],
      "def": "10 kg",
      "apply": {
        "5 kg":  { "start": { "food": 5  } },
        "10 kg": { "start": { "food": 10 } },
        "15 kg": { "start": { "food": 15 } },
        "20 kg": { "start": { "food": 20 } }
      }
    }
  ]
