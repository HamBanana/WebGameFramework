// parts/Main.js — scene, wired by owui-games-tool.
(function (G, GF) {
  'use strict';

  class Main extends GF.Scene {
    init(engine) {
      this.engine = engine;
      this.phase = 'menu';
      this.score = 0;
      this.lives = 3;
      this.player = null;
      this.invaders = [];
      this.bullets = [];
      this.invaderDir = 1;
      this.invaderSpeed = 60;
      this.invaderDropAmount = 16;
      this.fireCooldown = 0;
      this.gameOverTimer = 0;
      this.ufo = null;
      this.ufoTimer = 20;
      this.ufoSpeed = 100;
      this.powerups = [];
      this.powerupTypes = ['speed', 'laser', 'sidecannons'];
      this.shootRate = 0.3;

      engine.input.bind('left', 'KeyA', 'ArrowLeft');
      engine.input.bind('right', 'KeyD', 'ArrowRight');
      engine.input.bind('fire', 'Space');
      engine.input.bind('confirm', 'Space', 'Enter');
    }

    startGame() {
      const W = this.engine.config.width;
      const H = this.engine.config.height;
      this.player = new G.components.Player(W / 2 - 20, H - 50);
      this.invaders = [];
      this.bullets = [];
      this.score = 0;
      this.lives = 3;
      this.invaderDir = 1;
      this.invaderSpeed = 60;
      this.fireCooldown = 0;
      this.gameOverTimer = 0;
      this.ufo = null;
      this.ufoTimer = 20;

      // Build invader grid: 5 rows x 8 cols
      const cols = 8, rows = 5;
      const spacingX = 56, spacingY = 40;
      const startX = (W - cols * spacingX) / 2 + 12;
      const startY = 50;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          this.invaders.push(new G.components.Invader(
            startX + c * spacingX, startY + r * spacingY, r % 3
          ));
        }
      }
    }

    shoot() {
      if (this.fireCooldown > 0) return;
      this.fireCooldown = this.player.shootRate || 0.3;
      const bt = this.player.getBulletType();
      const bx = this.player.x + this.player.w / 2 - 2;
      const by = this.player.y - 12;
      this.bullets.push(new G.components.Bullet(bx, by, bt));
      // Side cannons fire too if active
      if (this.player.needsSideCannons()) {
        const lbx = this.player.x + this.player.leftCannonOffset + 4;
        const rbx = this.player.x + this.player.w + this.player.leftCannonOffset + 4;
        const lby = this.player.y - 6;
        this.bullets.push(new G.components.Bullet(lbx, lby, 'sidecannon'));
        this.bullets.push(new G.components.Bullet(rbx, lby, 'sidecannon'));
      }
    }

    overlap(a, b) {
      return a.x < b.x + b.w && a.x + a.w > b.x &&
             a.y < b.y + b.h && a.y + a.h > b.y;
    }

    dropPowerup(x, y) {
      var r = Math.random();
      var type;
      if (r < 0.33) type = 'speed';
      else if (r < 0.66) type = 'laser';
      else type = 'sidecannons';
      this.powerups.push(new G.components.Powerup(x, y, type));
    }

    update(dt, engine) {
      if (this.phase === 'menu') {
        if (engine.input.wasPressed('confirm')) {
          this.phase = 'play';
          this.startGame();
        }
      } else if (this.phase === 'play') {
        this.fireCooldown = Math.max(0, this.fireCooldown - dt);

        // Player movement
        this.player.update(dt, engine);

        // Fire
        if (engine.input.wasPressed('fire')) this.shoot();

        // Update bullets
        for (const b of this.bullets) b.update(dt);
        this.bullets = this.bullets.filter(b => b.alive);

        // Move invaders as a formation
        let hitEdge = false;
        const W = engine.config.width;
        for (const inv of this.invaders) {
          if (inv.x + inv.w >= W - 4 || inv.x <= 4) {
            hitEdge = true;
            break;
          }
        }
        if (hitEdge) {
          this.invaderDir *= -1;
          for (const inv of this.invaders) {
            inv.y += this.invaderDropAmount;
          }
        }
        for (const inv of this.invaders) {
          inv.x += this.invaderSpeed * this.invaderDir * dt;
        }

        // UFO bonus: spawn every 20 seconds, flies across top
        this.ufoTimer -= dt;
        if (this.ufoTimer <= 0 && !this.ufo) {
          this.ufoTimer = 20;
          const dir = Math.random() < 0.5 ? 1 : -1;
          const ufoW = 48, ufoH = 20;
          this.ufo = { x: dir === 1 ? -ufoW : W, y: 20, w: ufoW, h: ufoH, dir: dir };
        }
        if (this.ufo) {
          this.ufo.x += this.ufoSpeed * this.ufo.dir * dt;
          if ((this.ufo.dir === 1 && this.ufo.x > W + this.ufo.w) ||
              (this.ufo.dir === -1 && this.ufo.x + this.ufo.w < -this.ufo.w)) {
            this.ufo = null;
          }
        }

        // Bullet vs invader collision
        for (const b of this.bullets) {
          for (const inv of this.invaders) {
            if (b.alive && inv.alive && this.overlap(b, inv)) {
              if (b.type === 'laser') {
                // Laser kills entire column of invaders
                var colInvaders = [];
                for (const otherInv of this.invaders) {
                  if (otherInv.alive && Math.abs(otherInv.x - inv.x) < 1) {
                    colInvaders.push(otherInv);
                  }
                }
                for (const ci of colInvaders) {
                  ci.alive = false;
                  this.score += (3 - ci.type) * 10;
                  if (Math.random() < 0.15) this.dropPowerup(ci.x + ci.w / 2, ci.y);
                }
                b.alive = false;
              } else {
                b.alive = false;
                inv.alive = false;
                this.score += (3 - inv.type) * 10;
                if (Math.random() < 0.15) this.dropPowerup(inv.x + inv.w / 2, inv.y);
              }
            }
          }
        }
        this.bullets = this.bullets.filter(b => b.alive);
        this.invaders = this.invaders.filter(inv => inv.alive);

        // Bullet vs UFO collision
        if (this.ufo) {
          for (const b of this.bullets) {
            if (b.alive && this.overlap(b, this.ufo)) {
              b.alive = false;
              this.score += 100;
              this.ufo = null;
              break;
            }
          }
        }

        // Update powerups (dropped items)
        for (const p of this.powerups) p.update(dt);
        this.powerups = this.powerups.filter(p => p.alive);
        // Powerup vs player collision
        for (const p of this.powerups) {
          if (p.alive && this.overlap(p, this.player)) {
            p.alive = false;
            this.player.activate(p.type);
          }
        }
        this.powerups = this.powerups.filter(p => p.alive);

        // Check win
        if (this.invaders.length === 0) {
          this.phase = 'over';
          this.won = true;
          this.gameOverTimer = 0;
        }

        // Check lose: invaders reach bottom or touch player
        const playerTop = this.player.y;
        for (const inv of this.invaders) {
          if (inv.y + inv.h >= playerTop) {
            this.phase = 'over';
            this.won = false;
            this.gameOverTimer = 0;
            break;
          }
        }

        // Invader touches player
        for (const inv of this.invaders) {
          if (this.overlap(this.player, inv)) {
            this.lives--;
            if (this.lives <= 0) {
              this.phase = 'over';
              this.won = false;
              this.gameOverTimer = 0;
            } else {
              this.invaders = this.invaders.filter(i => i !== inv);
            }
            break;
          }
        }

      } else if (this.phase === 'over') {
        this.gameOverTimer += dt;
        if (this.gameOverTimer > 0.5 && engine.input.wasPressed('confirm')) {
          this.phase = 'menu';
        }
      }
    }

    render(ctx, engine) {
      const W = engine.config.width;
      const H = engine.config.height;
      const cx = W / 2;

      if (this.phase === 'menu') {
        ctx.fillStyle = '#1a1a2e';
        ctx.fillRect(0, 0, W, H);
        GF.UISystem.drawText(ctx, 'HAM INVADERS', cx, H/2 - 60,
          { align: 'center', font: '48px monospace', color: '#ff6b6b' });
        GF.UISystem.drawText(ctx, '🐷 vs 👾', cx, H/2 - 10,
          { align: 'center', font: '36px monospace', color: '#fff' });
        GF.UISystem.drawText(ctx, 'Arrow Keys / A,D to move', cx, H/2 + 30,
          { align: 'center', font: '18px monospace', color: '#aaa' });
        GF.UISystem.drawText(ctx, 'Space to fire', cx, H/2 + 55,
          { align: 'center', font: '18px monospace', color: '#aaa' });
        GF.UISystem.drawText(ctx, 'Press Space to Start', cx, H/2 + 100,
          { align: 'center', font: '22px monospace', color: '#ffeb3b' });
      } else if (this.phase === 'play') {
        // Background
        ctx.fillStyle = '#1a1a2e';
        ctx.fillRect(0, 0, W, H);

        // Draw player
        this.player.draw(ctx);

        // Draw invaders

        // Draw invaders
        for (const inv of this.invaders) inv.draw(ctx);

        // Draw UFO
        if (this.ufo) {
          const u = this.ufo;
          ctx.fillStyle = '#ff6b6b';
          ctx.fillRect(u.x + 10, u.y + 5, u.w - 20, u.h - 10);
          ctx.fillRect(u.x + 20, u.y, 8, 6);
          ctx.fillRect(u.x, u.y + 5, 10, 10);
          ctx.fillRect(u.x + u.w - 10, u.y + 5, 10, 10);
          ctx.fillStyle = '#ffeb3b';
          ctx.fillRect(u.x + 8, u.y + 8, 4, 4);
          ctx.fillRect(u.x + u.w - 12, u.y + 8, 4, 4);
          ctx.fillRect(u.x + u.w / 2 - 2, u.y + 5, 4, 4);
        }

        // Draw bullets
        for (const b of this.bullets) b.draw(ctx);

        // Draw powerups
        for (const p of this.powerups) p.draw(ctx);

        // Powerup HUD indicator
        if (this.player.powerupType) {
          var pText = '';
          var pColor = '#fff';
          if (this.player.powerupType === 'speed') { pText = '⚡ SPEED'; pColor = '#ffeb3b'; }
          else if (this.player.powerupType === 'laser') { pText = '🔴 LASER'; pColor = '#ff6b6b'; }
          else if (this.player.powerupType === 'sidecannons') { pText = '💥 SIDE CANNONS'; pColor = '#2ecc71'; }
          if (pText) {
            GF.UISystem.drawText(ctx, pText + ' ' + Math.ceil(this.player.powerupTimer) + 's', cx, 12,
              { font: '16px monospace', color: pColor, align: 'center', baseline: 'top' });
          }
        }

        // HUD
        GF.UISystem.drawText(ctx, 'Score: ' + this.score, 12, 12,
          { font: '20px monospace', color: '#fff', align: 'left', baseline: 'top' });
        GF.UISystem.drawText(ctx, 'Lives: ' + this.lives, W - 120, 12,
          { font: '20px monospace', color: '#fff', align: 'left', baseline: 'top' });

      } else if (this.phase === 'over') {
        ctx.fillStyle = '#1a1a2e';
        ctx.fillRect(0, 0, W, H);
        const title = this.won ? 'YOU WIN!' : 'GAME OVER';
        const color = this.won ? '#2ecc71' : '#e74c3c';
        GF.UISystem.drawText(ctx, title, cx, H/2 - 40,
          { align: 'center', font: '42px monospace', color: color });
        GF.UISystem.drawText(ctx, 'Final Score: ' + this.score, cx, H/2 + 10,
          { align: 'center', font: '24px monospace', color: '#fff' });
        GF.UISystem.drawText(ctx, 'Press Space to Continue', cx, H/2 + 50,
          { align: 'center', font: '20px monospace', color: '#ffeb3b' });
      }
    }
  }

  G.scenes.Main = Main;
})(window.GAME = window.GAME || { components: {}, scenes: {}, systems: {}, state: {} }, window.GF);
